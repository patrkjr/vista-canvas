{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "types": ["vite/client"]
  },
  "include": [
    "src/canvas/**/*.ts",
    "src/adapters/**/*.ts",
    "src/preview/**/*.ts",
    "demo/seed/**/*.json",
    "vite.config.ts"
  ]
}
