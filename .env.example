# Required: absolute path to the target app repo (contains .design-canvas.json).
DESIGN_CANVAS_TARGET=/absolute/path/to/mock-bank-mfe

# Shell origin for iframe mounts, meso capture, and runtime Map.
# Local mock bank: http://localhost:4200
DESIGN_CANVAS_APP_ORIGIN=http://localhost:4200

# When the Copilot extension is copied outside this repo (e.g. ~/.copilot/extensions/),
# point at the vista-canvas clone that has dist/ after npm run build.
# DESIGN_CANVAS_HOME=/absolute/path/to/vista-canvas

# Optional Playwright storageState JSON for authenticated staging hosts.
# Create once: npx playwright codegen --save-storage=./.design-canvas-auth.json https://staging.example
# DESIGN_CANVAS_STORAGE_STATE=/absolute/path/to/.design-canvas-auth.json

# When 1, the API also serves the built web UI from dist/ (Copilot / npm run start:web).
# DESIGN_CANVAS_SERVE_UI=1

# API listen port (dev API defaults to 4174; Copilot spawn uses 4173 with SERVE_UI=1).
# DESIGN_CANVAS_API_PORT=4174

# Optional CORS origin override for the Agent API.
# DESIGN_CANVAS_CORS_ORIGIN=http://127.0.0.1:4173
